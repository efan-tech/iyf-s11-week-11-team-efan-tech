import React, { useState } from 'react';
import { useNavigate, useLocation } from 'react-router-dom';

const Auth = () => {
  const navigate = useNavigate();
  const location = useLocation();

  // Default to register if user landed on /register, otherwise login
  const [mode, setMode] = useState(
    location.pathname === '/register' ? 'register' : 'login'
  );

  const [formData, setFormData] = useState({
    identifier: '',
    username: '',
    email: '',
    password: '',
    confirmPassword: '',
  });

  const handleChange = (e) => {
    setFormData({ ...formData, [e.target.name]: e.target.value });
  };

  const passwordsMatch =
    formData.password === formData.confirmPassword || mode === 'login';

  const handleSubmit = (e) => {
    e.preventDefault();
    if (mode === 'register' && !passwordsMatch) return;

    // Demo bypass – same as before
    localStorage.setItem('token', 'quantum-operator-session');

    // Optional: save a simple user object
    if (mode === 'register') {
      localStorage.setItem(
        'ql_user',
        JSON.stringify({
          username: formData.username || formData.email.split('@')[0],
          handle: `@${formData.username || 'operator'}`,
          status: 'Active',
        })
      );
    }

    navigate('/dashboard');
  };

  const switchMode = (newMode) => {
    setMode(newMode);
    // Clear form when switching
    setFormData({
      identifier: '',
      username: '',
      email: '',
      password: '',
      confirmPassword: '',
    });
  };

  return (
    <div style={styles.container}>
      <div style={styles.card}>
        <div style={styles.badge}>QUANTUM LOGIC VERIFICATION</div>

        <h2 style={styles.title}>
          {mode === 'login' ? 'System Login' : 'Create Access'}
        </h2>
        <p style={styles.subtitle}>
          {mode === 'login'
            ? 'Enter your credentials to access the terminal.'
            : 'Create your account in a few seconds.'}
        </p>

        {/* Tabs */}
        <div style={styles.tabs}>
          <button
            type="button"
            onClick={() => switchMode('login')}
            style={{
              ...styles.tab,
              ...(mode === 'login' ? styles.tabActive : {}),
            }}
          >
            Login
          </button>
          <button
            type="button"
            onClick={() => switchMode('register')}
            style={{
              ...styles.tab,
              ...(mode === 'register' ? styles.tabActive : {}),
            }}
          >
            Register
          </button>
        </div>

        <form onSubmit={handleSubmit} style={styles.form}>
          {mode === 'login' ? (
            <>
              <div style={styles.inputGroup}>
                <label style={styles.label}>Operator ID / Email</label>
                <input
                  type="text"
                  name="identifier"
                  placeholder="quantum_admin or operator@quantum.io"
                  value={formData.identifier}
                  onChange={handleChange}
                  required
                  style={styles.input}
                />
              </div>

              <div style={styles.inputGroup}>
                <label style={styles.label}>Access Key</label>
                <input
                  type="password"
                  name="password"
                  placeholder="••••••••••••"
                  value={formData.password}
                  onChange={handleChange}
                  required
                  style={styles.input}
                />
              </div>
            </>
          ) : (
            <>
              <div style={styles.inputGroup}>
                <label style={styles.label}>Username</label>
                <input
                  type="text"
                  name="username"
                  placeholder="quantum_admin"
                  value={formData.username}
                  onChange={handleChange}
                  required
                  style={styles.input}
                />
              </div>

              <div style={styles.inputGroup}>
                <label style={styles.label}>Email</label>
                <input
                  type="email"
                  name="email"
                  placeholder="operator@quantum.io"
                  value={formData.email}
                  onChange={handleChange}
                  required
                  style={styles.input}
                />
              </div>

              <div style={styles.inputGroup}>
                <label style={styles.label}>Access Key</label>
                <input
                  type="password"
                  name="password"
                  placeholder="••••••••••••"
                  value={formData.password}
                  onChange={handleChange}
                  required
                  style={styles.input}
                />
              </div>

              <div style={styles.inputGroup}>
                <label style={styles.label}>Confirm Access Key</label>
                <input
                  type="password"
                  name="confirmPassword"
                  placeholder="••••••••••••"
                  value={formData.confirmPassword}
                  onChange={handleChange}
                  required
                  style={styles.input}
                />
                {!passwordsMatch && formData.confirmPassword.length > 0 && (
                  <span style={styles.helperText}>Passwords do not match</span>
                )}
              </div>
            </>
          )}

          <button type="submit" style={styles.button}>
            {mode === 'login' ? 'Authenticate Session' : 'Create Account'}
          </button>
        </form>

        <p style={styles.footerText}>
          {mode === 'login' ? (
            <>
              New here?{' '}
              <button
                type="button"
                onClick={() => switchMode('register')}
                style={styles.linkButton}
              >
                Create an account
              </button>
            </>
          ) : (
            <>
              Already have access?{' '}
              <button
                type="button"
                onClick={() => switchMode('login')}
                style={styles.linkButton}
              >
                Login instead
              </button>
            </>
          )}
        </p>
      </div>
    </div>
  );
};

